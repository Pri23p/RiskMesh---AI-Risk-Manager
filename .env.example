# ==============================================
# RiskSentinel - Environment Variables Configuration
# ==============================================

# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL Database Configuration
POSTGRES_USER=risksentinel
POSTGRES_PASSWORD=risksentinel_secure_pass
POSTGRES_DB=risksentinel_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://risksentinel:risksentinel_secure_pass@localhost:5432/risksentinel_db?schema=public

# API Configuration
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
